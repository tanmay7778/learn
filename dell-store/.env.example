# ============================================
# Dell Store — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)

# Flask secret key (generate a random string)
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# Database URL
# Local (SQLite — default, no setup needed):
#   Leave blank or don't set — app uses sqlite:///dell_store.db automatically
# Production (PostgreSQL — Render/Railway provides this):
#   DATABASE_URL=postgresql://user:password@host:5432/dellstore
DATABASE_URL=

# Groq LLM API Key (free: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Debug mode (set to False in production)
DEBUG=True
